# Example env file for RapidAPI keys and configuration
# Copy this to `backend/.env` and fill in real keys. DO NOT commit `backend/.env` to git.

# General
MOCK=true  # Set to false to enable live calls (only with RAPIDAPI_KEY set and explicit --live)

# RapidAPI credentials
RAPIDAPI_KEY=

# Optional per-provider hostnames (used by some adapters)
HOTELS_RAPIDAPI_HOST=hotels4.p.rapidapi.com
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com
PRICELINE_RAPIDAPI_HOST=priceline-com.p.rapidapi.com
TRIPADVISOR_RAPIDAPI_HOST=tripadvisor16.p.rapidapi.com

# Local cache path (relative to repo root)
RAPIDAPI_CACHE_DIR=data/raw/rapidapi

# Example usage notes:
# - Keep MOCK=true for development. To run live: set MOCK=false and provide RAPIDAPI_KEY in backend/.env
# - Always rotate keys if they were pasted into public places (chat, PRs, etc.)
